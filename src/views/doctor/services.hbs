<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Services — PMA Doctor Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        },
      },
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background-color: #0f172a; color: white; }
    .glass-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .input-field { transition: all 0.3s; }
    .input-field:focus { box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3); border-color: #3b82f6; outline: none; }
    .toast { transform: translateX(120%); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .toast.show { transform: translateX(0); }
    .input-field { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .input-field:focus { box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3); border-color: #3b82f6; outline: none; }
    .btn-primary { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); background: linear-gradient(135deg, #3b82f6, #7c3aed); }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.4); background: linear-gradient(135deg, #2563eb, #6d28d9); }
    .btn-primary:active { transform: translateY(0); }
    .spinner { border: 2px solid rgba(255,255,255,0.3); border-top: 2px solid white; border-radius: 50%; width: 20px; height: 20px; animation: spin 0.8s linear infinite; display: inline-block; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body class="h-full flex overflow-hidden">
  
  <div id="toast-container" class="fixed top-6 right-6 z-50 flex flex-col gap-3"></div>

  <!-- Sidebar -->
  <aside class="w-64 glass-card border-r border-white/10 h-full flex flex-col">
    <div class="p-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
            <i data-lucide="stethoscope" class="w-5 h-5 text-white"></i>
          </div>
          <span class="font-bold text-lg tracking-tight">Doctor Portal</span>
        </div>

       
      </div>
    </div>
    
    <div class="px-3 pb-6 flex-1 flex flex-col gap-1">
      <a href="/doctor/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 font-medium transition-colors">
        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
        Dashboard
      </a>
      <a href="/doctor/services" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/10 text-white font-medium">
        <i data-lucide="briefcase-medical" class="w-5 h-5"></i>
        Services
      </a>
      <a href="/doctor/consultations" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 font-medium transition-colors">
        <i data-lucide="calendar-days" class="w-5 h-5"></i>
        Consultations
      </a>
    </div>

    <div class="p-4 border-t border-white/10">
      <button onclick="logout()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg w-full text-slate-400 hover:text-red-400 font-medium transition-colors">
        <i data-lucide="log-out" class="w-5 h-5"></i>
        Logout
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 h-full overflow-y-auto bg-[#0a0f1d] relative">
    <div class="p-8 max-w-6xl mx-auto space-y-8">
      
      <!-- Header -->
      <header class="flex items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">My Services</h1>
          <p class="text-slate-400 text-sm mt-1">Manage your consultancy pricing and durations</p>
        </div>
        
         <!-- Profile button & dropdown -->
        <div class="relative flex-shrink-0">
          <button id="profile-btn" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
            <img id="profile-avatar" src="https://ui-avatars.com/api/?name=Doctor&background=random" alt="Profile" class="w-9 h-9 rounded-full border-2 border-blue-400 object-cover" />
          </button>

          <!-- Profile Popup Dropdown -->
          <div id="profile-popup" class="hidden absolute top-12 right-0 mt-1 w-64 glass-card rounded-xl shadow-2xl border border-white/10 overflow-hidden transform transition-all opacity-0 scale-95" style="z-index:100">
            <div class="p-4 border-b border-white/10">
              <p id="popup-name" class="font-bold text-white truncate">Doctor Name</p>
              <p id="popup-email" class="text-sm text-gray-400 truncate">doctor@example.com</p>
            </div>
            <div class="p-2">
              <button id="edit-profile-btn" class="w-full text-left px-4 py-2 hover:bg-white/10 rounded-lg flex items-center gap-2 transition-colors text-sm">
                <i data-lucide="user-cog" class="w-4 h-4"></i> Edit Profile
              </button>
            </div>
          </div>
        </div>
      </header>
      <button onclick="openModal()" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-xl font-medium text-sm transition flex items-center gap-2 shadow-lg shadow-blue-500/20">
          <i data-lucide="plus" class="w-4 h-4"></i> Add Service
        </button>

      <div id="loading" class="text-center py-10 text-slate-500">Loading services...</div>
      
      <div id="noServices" class="hidden glass-card rounded-2xl p-10 text-center">
        <div class="w-16 h-16 rounded-full bg-blue-500/10 flex items-center justify-center mx-auto mb-4">
          <i data-lucide="briefcase-medical" class="w-8 h-8 text-blue-400"></i>
        </div>
        <h3 class="text-lg font-medium text-white mb-2">No services added yet</h3>
        <p class="text-slate-400 text-sm mb-6">Create your first consultancy service tier.</p>
        <button onclick="openModal()" class="text-blue-400 hover:text-blue-300 font-medium text-sm transition">
          + Add New Service
        </button>
      </div>

      <!-- Services List -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="servicesContainer"></div>
    </div>

    <!-- Modal Background -->
    <div id="serviceModal" class="hidden absolute inset-0 bg-[#0a0f1d]/80 flex items-center justify-center p-4 backdrop-blur-sm z-40 transition-opacity">
      <div class="glass-card w-full max-w-md rounded-2xl overflow-hidden shadow-2xl border border-white/10">
        <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-white" id="modalTitle">Add New Service</h3>
          <button onclick="closeModal()" class="text-slate-400 hover:text-white transition">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        <form id="serviceForm" class="p-6 space-y-4">
          <input type="hidden" id="serviceId" />
          
          <div class="space-y-1.5">
            <label class="block text-sm font-medium text-slate-300">Service Name</label>
            <input type="text" id="serviceName" required placeholder="e.g. General Consulatation"
              class="input-field w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500" />
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="block text-sm font-medium text-slate-300">Cost/Hour ($)</label>
              <input type="number" id="costPerHour" required min="0" step="0.01" placeholder="50.00"
                class="input-field w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500" />
            </div>
            <div class="space-y-1.5">
              <label class="block text-sm font-medium text-slate-300">Duration (Hours)</label>
              <input type="number" id="durationHours" required min="1" step="1" value="1"
                class="input-field w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500" />
            </div>
          </div>
          
          <div class="pt-4 flex gap-3">
            <button type="button" onclick="closeModal()" class="flex-1 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-medium text-sm transition">Cancel</button>
            <button type="submit" id="saveBtn" class="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition">Save Service</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <!-- Edit Profile Modal -->
  <div id="edit-profile-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
    <div class="glass-card w-full max-w-md rounded-2xl p-6 relative">
      <button id="close-modal-btn" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
      <h2 class="text-2xl font-bold mb-6">Edit Profile</h2>
      <form id="edit-profile-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Name</label>
          <input type="text" id="edit-name" name="doctorName" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white input-field focus:outline-none" required />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Specialization</label>
          <input type="text" id="edit-specialization" name="specialization" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white input-field focus:outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Qualifications</label>
          <input type="text" id="edit-qualifications" name="qualifications" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white input-field focus:outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Phone Number</label>
          <input type="text" id="edit-phone" name="phoneNumber" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white input-field focus:outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Bio</label>
          <textarea id="edit-bio" name="bio" rows="2" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white input-field focus:outline-none"></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Profile Image</label>
          <input type="file" id="edit-image" name="file" accept="image/jpeg, image/png" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-500/20 file:text-blue-400 hover:file:bg-blue-500/30" />
        </div>
        <button type="submit" class="w-full btn-primary py-3 rounded-lg font-semibold flex items-center justify-center gap-2 mt-4 text-white">
          Save Changes
        </button>
      </form>
    </div>
  </div>

  <script>
    lucide.createIcons();

    // ── Profile Bar Logic ──────────────────────────────────────────────────
    (function initProfileBar() {
      const token = sessionStorage.getItem('doctor_token');
      const profileBtn     = document.getElementById('profile-btn');
      const profilePopup   = document.getElementById('profile-popup');
      const editProfileBtn = document.getElementById('edit-profile-btn');
      const editModal      = document.getElementById('edit-profile-modal');
      const closeModalBtn  = document.getElementById('close-modal-btn');
      const editForm       = document.getElementById('edit-profile-form');
      const popupName      = document.getElementById('popup-name');
      const popupEmail     = document.getElementById('popup-email');
      const profileAvatar  = document.getElementById('profile-avatar');

      /** Fetch and display the doctor's profile data */
      function toDriveDirectUrl(url) {
  if (!url) return '';
  
  // Extract File ID from drive.google.com/uc?export=view&id=FILE_ID or drive.google.com/file/d/FILE_ID
  const match = url.match(/id=([a-zA-Z0-9_-]+)/) || url.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (match && match[1]) {
    const fileId = match[1];
    // Use Google's CDN endpoint which allows cross-origin img embedding
    return `https://lh3.googleusercontent.com/d/${fileId}`;
  }
  
  return url;
}
      function fetchProfile() {
        fetch('/{{apiBase}}/doctors/profile', {
          headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
          if (data && !data.statusCode) {
            popupName.textContent  = data.doctorName  || 'Doctor';
            popupEmail.textContent = data.doctorEmail || '';
              const directImageUrl = toDriveDirectUrl(data.doctorImageUrl);
            profileAvatar.src = directImageUrl
              ? directImageUrl
              : `https://ui-avatars.com/api/?name=${encodeURIComponent(data.doctorName || 'Doctor')}&background=random`;
            document.getElementById('edit-name').value           = data.doctorName      || '';
            document.getElementById('edit-specialization').value = data.specialization  || '';
            document.getElementById('edit-qualifications').value = data.qualifications  || '';
            document.getElementById('edit-phone').value          = data.phoneNumber     || '';
            document.getElementById('edit-bio').value            = data.bio             || '';
          }
        })
        .catch(err => console.error('Profile fetch error:', err));
      }

      if (token) fetchProfile();

      /** Toggle profile popup visibility */
      profileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        profilePopup.classList.toggle('hidden');
        setTimeout(() => {
          profilePopup.classList.toggle('opacity-0');
          profilePopup.classList.toggle('scale-95');
        }, 10);
      });

      /** Close popup on outside click */
      document.addEventListener('click', () => {
        if (!profilePopup.classList.contains('hidden')) {
          profilePopup.classList.add('opacity-0', 'scale-95');
          setTimeout(() => profilePopup.classList.add('hidden'), 200);
        }
      });
      profilePopup.addEventListener('click', (e) => e.stopPropagation());

      /** Open edit modal from popup */
      editProfileBtn.addEventListener('click', () => {
        profilePopup.classList.add('opacity-0', 'scale-95');
        setTimeout(() => profilePopup.classList.add('hidden'), 200);
        editModal.classList.remove('hidden');
      });

      /** Close edit modal */
      closeModalBtn.addEventListener('click', () => editModal.classList.add('hidden'));

      /** Submit edited profile */
      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');
        const original = btn.innerHTML;
        btn.innerHTML = '<div class="spinner"></div> Saving...';
        btn.disabled = true;

        try {
          const res = await fetch('/{{apiBase}}/doctors/profile', {
            method: 'PATCH',
            headers: { 'Authorization': `Bearer ${token}` },
            body: new FormData(editForm)
          });
          const data = await res.json();
          if (res.ok) {
            showToast('Profile updated successfully');
            editModal.classList.add('hidden');
            fetchProfile();
          } else {
            showToast(data.message || 'Failed to update profile', 'error');
          }
        } catch {
          showToast('Network error', 'error');
        } finally {
          btn.innerHTML = original;
          btn.disabled = false;
        }
      });
    })();
    // ──────────────────────────────────────────────────────────────────────

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colorMap = { success: 'bg-emerald-500/90 border-emerald-400', error: 'bg-red-500/90 border-red-400', info: 'bg-blue-500/90 border-blue-400' };
      const iconMap = { success: 'check-circle', error: 'x-circle', info: 'info' };
      toast.className = `toast ${colorMap[type]} border backdrop-blur-sm text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 min-w-[300px]`;
      toast.innerHTML = `<i data-lucide="${iconMap[type]}" class="w-5 h-5"></i><span class="text-sm font-medium">${message}</span>`;
      container.appendChild(toast);
      lucide.createIcons({ nodes: [toast] });
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 4000);
    }

    function logout() {
      sessionStorage.removeItem('doctor_token');
      sessionStorage.removeItem('doctor_info');
      window.location.href = '/doctor/login';
    }

    const token = sessionStorage.getItem('doctor_token');
    if (!token) window.location.href = '/doctor/login';

    const renderServices = (services) => {
      const container = document.getElementById('servicesContainer');
      const noServices = document.getElementById('noServices');
      
      if (services.length === 0) {
        container.innerHTML = '';
        noServices.classList.remove('hidden');
        return;
      }
      
      noServices.classList.add('hidden');
      container.innerHTML = services.map(s => `
        <div class="glass-card rounded-2xl p-6 relative border border-white/5 hover:border-white/10 transition-colors">
          <div class="flex justify-between items-start mb-4">
            <h3 class="font-semibold text-lg text-white pr-8">${s.serviceName}</h3>
            <div class="flex items-center gap-2 absolute top-6 right-6">
              <button onclick="editService(${s.serviceId}, '${s.serviceName.replace(/'/g, "\\'")}', ${s.costPerHour}, ${s.durationHours})" class="text-slate-400 hover:text-blue-400 transition" title="Edit">
                <i data-lucide="pencil" class="w-4 h-4"></i>
              </button>
              <button onclick="deleteService(${s.serviceId})" class="text-slate-400 hover:text-red-400 transition" title="Delete">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
          
          <div class="flex flex-col gap-2">
            <div class="flex justify-between text-sm">
              <span class="text-slate-400">Rate:</span>
              <span class="text-white font-medium">$${s.costPerHour}/hr</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-400">Duration:</span>
              <span class="text-white font-medium">${s.durationHours} Hour${s.durationHours > 1 ? 's' : ''}</span>
            </div>
            <div class="h-px w-full bg-white/10 my-1"></div>
            <div class="flex justify-between text-md">
              <span class="font-medium text-slate-300">Total Cost:</span>
              <span class="font-bold text-emerald-400">$${s.totalCost}</span>
            </div>
          </div>
        </div>
      `).join('');
      
      lucide.createIcons();
    };

    const fetchServices = async () => {
      document.getElementById('loading').classList.remove('hidden');
      document.getElementById('servicesContainer').innerHTML = '';
      document.getElementById('noServices').classList.add('hidden');
      
      try {
        const res = await fetch('/{{apiBase}}/doctors/services', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.status === 401 || res.status === 403) return logout();
        if (!res.ok) throw new Error('Failed to load services');
        const data = await res.json();
        
        renderServices(data);
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        document.getElementById('loading').classList.add('hidden');
      }
    };

    // Modal behavior
    const modal = document.getElementById('serviceModal');
    
    window.openModal = () => {
      document.getElementById('serviceForm').reset();
      document.getElementById('serviceId').value = '';
      document.getElementById('modalTitle').innerText = 'Add New Service';
      modal.classList.remove('hidden');
    };
    
    window.closeModal = () => {
      modal.classList.add('hidden');
    };

    window.editService = (id, name, cost, duration) => {
      document.getElementById('serviceId').value = id;
      document.getElementById('serviceName').value = name;
      document.getElementById('costPerHour').value = cost;
      document.getElementById('durationHours').value = duration;
      document.getElementById('modalTitle').innerText = 'Edit Service';
      modal.classList.remove('hidden');
    };

    window.deleteService = async (id) => {
      if(!confirm('Are you sure you want to delete this service?')) return;
      
      try {
        const res = await fetch(`/{{apiBase}}/doctors/services/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('Failed to delete service');
        showToast('Service deleted successfully');
        fetchServices();
      } catch(err) {
        showToast(err.message, 'error');
      }
    };

    document.getElementById('serviceForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('serviceId').value;
      const payload = {
        serviceName: document.getElementById('serviceName').value.trim(),
        costPerHour: Number(document.getElementById('costPerHour').value),
        durationHours: Number(document.getElementById('durationHours').value)
      };
      
      const isEdit = !!id;
      const url = `/{{apiBase}}/doctors/services` + (isEdit ? `/${id}` : '');
      const method = isEdit ? 'PATCH' : 'POST';
      
      const btn = document.getElementById('saveBtn');
      btn.disabled = true;
      btn.innerText = 'Saving...';
      
      try {
        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(payload)
        });
        
        const data = await res.json();
        if (!res.ok) {
           const msg = Array.isArray(data.message) ? data.message.join(', ') : data.message;
           throw new Error(msg || 'Failed to save service');
        }
        
        showToast(`Service ${isEdit ? 'updated' : 'created'} successfully!`);
        closeModal();
        fetchServices();
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Save Service';
      }
    });

    // initial fetch
    fetchServices();
  </script>
</body>
</html>
