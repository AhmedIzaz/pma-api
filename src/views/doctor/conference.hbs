<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Consultations — PMA Doctor Portal</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        },
      },
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background-color: #0f172a; color: white; }
    .glass-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .input-field { transition: all 0.3s; }
    .input-field:focus { box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3); border-color: #3b82f6; outline: none; }
    .toast { transform: translateX(120%); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .toast.show { transform: translateX(0); }
  </style>
</head>
<body class="h-full flex overflow-hidden">
  
  <div id="toast-container" class="fixed top-6 right-6 z-50 flex flex-col gap-3"></div>

  <!-- Sidebar -->
  <aside class="w-64 glass-card border-r border-white/10 h-full flex flex-col">
    <div class="p-6">
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
          <i data-lucide="stethoscope" class="w-5 h-5 text-white"></i>
        </div>
        <span class="font-bold text-lg tracking-tight">Doctor Portal</span>
      </div>
    </div>
    
    <div class="px-3 pb-6 flex-1 flex flex-col gap-1">
      <a href="/doctor/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 font-medium transition-colors">
        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
        Dashboard
      </a>
      <a href="/doctor/services" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 font-medium transition-colors">
        <i data-lucide="briefcase-medical" class="w-5 h-5"></i>
        Services
      </a>
      <a href="/doctor/consultations" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/10 text-white font-medium">
        <i data-lucide="calendar-days" class="w-5 h-5"></i>
        Consultations
      </a>
    </div>

    <div class="p-4 border-t border-white/10">
      <button onclick="logout()" class="flex items-center gap-3 px-3 py-2.5 rounded-lg w-full text-slate-400 hover:text-red-400 font-medium transition-colors">
        <i data-lucide="log-out" class="w-5 h-5"></i>
        Logout
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 h-full overflow-y-auto bg-[#0a0f1d] relative">
    <div class="p-8 max-w-6xl mx-auto space-y-8">
      
      <!-- Header -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Video Conference</h1>
          <p class="text-slate-400 text-sm mt-1">Ongoing consultation with your patient.</p>
        </div>
      </header>

      <div id="root" class="w-full h-[75vh] mt-8 bg-slate-900 rounded-xl overflow-hidden border border-white/10 shadow-2xl"></div>
      
      
    </div>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/@zegocloud/zego-uikit-prebuilt/zego-uikit-prebuilt.js"></script>
  <script>
    lucide.createIcons();
    
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colorMap = { success: 'bg-emerald-500/90 border-emerald-400', error: 'bg-red-500/90 border-red-400', info: 'bg-blue-500/90 border-blue-400' };
      const iconMap = { success: 'check-circle', error: 'x-circle', info: 'info' };
      toast.className = `toast ${colorMap[type]} border backdrop-blur-sm text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 min-w-[300px]`;
      toast.innerHTML = `<i data-lucide="${iconMap[type]}" class="w-5 h-5"></i><span class="text-sm font-medium">${message}</span>`;
      container.appendChild(toast);
      lucide.createIcons({ nodes: [toast] });
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 4000);
    }

    function logout() {
      sessionStorage.removeItem('doctor_token');
      sessionStorage.removeItem('doctor_info');
      window.location.href = '/doctor/login';
    }

    const token = sessionStorage.getItem('doctor_token');
    if (!token) window.location.href = '/doctor/login';


  const appId = Number("{{appId}}");
  const serverSecret = "{{serverSecret}}";
  const userId = "DOCTOR-"+"{{doctorId}}";
  const roomId = "{{consultationId}}";
  const userName = "{{doctorName}}" || "Doctor";

  console.log({
    appId,
    serverSecret,
    userId,
    roomId,
    userName
  })


  

    const joinTime = new Date();
    const apiBase = "{{apiBase}}";
    
    const kitToken = ZegoUIKitPrebuilt.generateKitTokenForTest(
      appId,
      serverSecret,
      roomId,
      userId,
      userName
    );

    const zp = ZegoUIKitPrebuilt.create(kitToken);

    zp.joinRoom({
      container: document.getElementById("root"),
      scenario: {
        mode: ZegoUIKitPrebuilt.VideoConference,
      },
      showLeaveRoomConfirmDialog: false,
      onLeaveRoom: () => {
        const leaveTime = new Date();
        const spentMinutes = Math.max(Math.round((leaveTime - joinTime) / 60000), 1);

        fetch(`/${apiBase}/doctors/consultations/${roomId}/duration`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ spentMinutes })
        }).then(() => {
          window.location.href = '/doctor/consultations';
        }).catch(err => {
          console.error('Failed to update duration:', err);
          window.location.href = '/doctor/consultations';
        });
      }
    });

  </script>

</body>
</html>
